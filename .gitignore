<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Math Adventure - ผจญภัยเศษส่วน & ร้อยละ ป.5</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <!-- Google Fonts: Kanit -->
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Kanit', sans-serif; }
        .pastel-shadow { box-shadow: 0 10px 25px -5px rgba(244, 114, 182, 0.2); }
    </style>
</head>
<body class="bg-gradient-to-br from-pink-50 via-purple-50 to-blue-50 min-h-screen text-slate-700 flex flex-col">

    <!-- Navbar -->
    <header class="bg-white/80 backdrop-blur-md shadow-sm sticky top-0 z-50 px-4 py-3 flex justify-between items-center">
        <div class="flex items-center space-x-2">
            <span class="text-2xl">🎮</span>
            <h1 class="font-bold text-lg bg-gradient-to-r from-pink-500 to-purple-600 bg-clip-text text-transparent">Math Adventure P.5</h1>
        </div>
        <div class="flex items-center space-x-2">
            <button onclick="switchTab('student')" id="nav-student" class="px-3 py-1.5 rounded-full text-sm font-medium bg-pink-500 text-white transition">โหมดเล่นเกม</button>
            <button onclick="switchTab('admin')" id="nav-admin" class="px-3 py-1.5 rounded-full text-sm font-medium bg-gray-100 text-slate-600 hover:bg-gray-200 transition">⚙️ ระบบแอดมิน</button>
        </div>
    </header>

    <!-- Main Container -->
    <main class="flex-1 max-w-4xl w-full mx-auto p-4 flex flex-col justify-center">

        <!-- STUDENT VIEW -->
        <div id="view-student" class="space-y-6">
            <!-- Welcome Card -->
            <div id="card-start" class="bg-white rounded-3xl p-6 md:p-8 pastel-shadow text-center space-y-4 border border-pink-100">
                <div class="w-20 h-20 bg-pink-100 rounded-full flex items-center justify-center mx-auto text-4xl">🐱</div>
                <h2 class="text-2xl font-bold text-slate-800">ยินดีต้อนรับสู่ดินแดนคณิตศาสตร์!</h2>
                <p class="text-slate-500 text-sm max-w-md mx-auto">ฝึกฝนทักษะเศษส่วนและการบวกลบคูณหารไปพร้อมกับการเก็บคะแนน สนุกและไม่เครียดแน่นอน!</p>
                
                <div class="max-w-xs mx-auto space-y-2 text-left">
                    <label class="text-xs font-semibold text-slate-400">ชื่อผู้เล่น (กรอกก่อนเริ่ม):</label>
                    <input type="text" id="player-name" placeholder="กรอกชื่อเล่นน้อง..." class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-pink-400 text-center font-medium">
                </div>

                <button onclick="startGame()" class="w-full max-w-xs bg-gradient-to-r from-pink-500 to-rose-500 text-white font-semibold py-3 rounded-xl shadow-lg shadow-pink-500/30 hover:opacity-95 transition">
                    🚀 เริ่มผจญภัยเลย!
                </button>
            </div>

            <!-- Quiz Card (Hidden by default) -->
            <div id="card-quiz" class="hidden bg-white rounded-3xl p-6 md:p-8 pastel-shadow space-y-6 border border-pink-100">
                <div class="flex justify-between items-center border-b border-slate-100 pb-3">
                    <span id="quiz-progress" class="text-xs font-semibold px-3 py-1 bg-pink-50 text-pink-500 rounded-full">คำถามที่ 1/5</span>
                    <div class="flex items-center space-x-2">
                        <span class="text-sm font-medium text-slate-400">คะแนน:</span>
                        <span id="quiz-score" class="font-bold text-pink-500 text-lg">0</span>
                    </div>
                </div>

                <div class="text-center space-y-2">
                    <h3 id="quiz-question" class="text-xl md:text-2xl font-bold text-slate-800">โจทย์คำถาม...</h3>
                    <p class="text-xs text-slate-400">เลือกคำตอบที่ถูกต้องที่สุดด้านล่าง</p>
                </div>

                <!-- Options Grid -->
                <div id="quiz-options" class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    <!-- Options injected by JS -->
                </div>

                <!-- Scratchpad Toggle Button -->
                <div class="text-center pt-2">
                    <button onclick="toggleScratchpad()" class="text-xs font-medium text-purple-600 bg-purple-50 px-4 py-2 rounded-xl hover:bg-purple-100 transition">
                        📝 เปิดกระดานทดเลข (Canvas)
                    </button>
                </div>

                <!-- Scratchpad Area -->
                <div id="scratchpad-container" class="hidden space-y-2 border border-purple-100 p-3 rounded-2xl bg-purple-50/30">
                    <div class="flex justify-between items-center text-xs text-purple-600 font-medium px-1">
                        <span>กระดานทดเลขสำหรับน้อง:</span>
                        <button onclick="clearCanvas()" class="text-rose-500 hover:underline">ล้างกระดาน</button>
                    </div>
                    <canvas id="scratch-canvas" class="w-full h-48 bg-white rounded-xl border border-purple-200 cursor-crosshair touch-none"></canvas>
                </div>
            </div>

            <!-- Result Card (Hidden by default) -->
            <div id="card-result" class="hidden bg-white rounded-3xl p-6 md:p-8 pastel-shadow text-center space-y-4 border border-pink-100">
                <div class="w-20 h-20 bg-amber-100 rounded-full flex items-center justify-center mx-auto text-4xl">🏆</div>
                <h3 class="text-2xl font-bold text-slate-800">จบการผจญภัยแล้ว!</h3>
                <p id="result-summary" class="text-slate-500 text-sm">ยอดเยี่ยมมาก!</p>
                <div class="p-4 bg-pink-50 rounded-2xl max-w-xs mx-auto">
                    <span class="text-xs text-slate-400 block">คะแนนรวมทั้งหมด</span>
                    <span id="final-score" class="text-3xl font-bold text-pink-500">0</span>
                </div>
                <button onclick="resetGame()" class="w-full max-w-xs bg-slate-800 text-white font-semibold py-3 rounded-xl hover:bg-slate-700 transition">
                    🔄 เล่นใหม่อีกครั้ง
                </button>
            </div>
        </div>

        <!-- ADMIN VIEW -->
        <div id="view-admin" class="hidden space-y-6">
            <div class="bg-white rounded-3xl p-6 md:p-8 pastel-shadow space-y-6 border border-slate-100">
                <div class="flex justify-between items-center border-b border-slate-100 pb-4">
                    <div>
                        <h2 class="text-xl font-bold text-slate-800">⚙️ ระบบจัดการแอดมิน (ครูผู้สอน)</h2>
                        <p class="text-xs text-slate-400">ระบบไลฟ์บันทึกคะแนนและเพิ่มโจทย์คำถาม</p>
                    </div>
                    <div class="flex space-x-2">
                        <button onclick="exportData()" class="text-xs bg-blue-50 text-blue-600 px-3 py-1.5 rounded-xl font-medium hover:bg-blue-100">📥 สำรองข้อมูล</button>
                        <button onclick="clearHistory()" class="text-xs bg-rose-50 text-rose-600 px-3 py-1.5 rounded-xl font-medium hover:bg-rose-100">🗑️ ล้างประวัติ</button>
                    </div>
                </div>

                <!-- Add Question Form -->
                <div class="space-y-4 bg-slate-50 p-4 rounded-2xl">
                    <h3 class="font-semibold text-sm text-slate-700">➕ เพิ่มโจทย์คำถามใหม่</h3>
                    <div class="space-y-3">
                        <input type="text" id="admin-q" placeholder="โจทย์คำถาม (เช่น 3/4 + 1/6 = ?)" class="w-full px-3 py-2 rounded-xl border border-slate-200 text-sm bg-white">
                        <div class="grid grid-cols-2 gap-2">
                            <input type="text" id="admin-opt0" placeholder="ตัวเลือกที่ 1 (ถูกต้อง)" class="px-3 py-2 rounded-xl border border-slate-200 text-sm bg-white">
                            <input type="text" id="admin-opt1" placeholder="ตัวเลือกที่ 2" class="px-3 py-2 rounded-xl border border-slate-200 text-sm bg-white">
                            <input type="text" id="admin-opt2" placeholder="ตัวเลือกที่ 3" class="px-3 py-2 rounded-xl border border-slate-200 text-sm bg-white">
                            <input type="text" id="admin-opt3" placeholder="ตัวเลือกที่ 4" class="px-3 py-2 rounded-xl border border-slate-200 text-sm bg-white">
                        </div>
                        <div class="flex items-center space-x-2">
                            <label class="text-xs text-slate-500">ระบุตำแหน่งตัวเลือกที่ถูกต้อง (0-3):</label>
                            <select id="admin-correct" class="px-2 py-1 rounded-lg border border-slate-200 text-sm bg-white">
                                <option value="0">ตัวเลือกที่ 1</option>
                                <option value="1">ตัวเลือกที่ 2</option>
                                <option value="2">ตัวเลือกที่ 3</option>
                                <option value="3">ตัวเลือกที่ 4</option>
                            </select>
                        </div>
                        <button onclick="addQuestion()" class="w-full bg-slate-800 text-white text-sm font-semibold py-2.5 rounded-xl hover:bg-slate-700 transition">บันทึกโจทย์ใหม่</button>
                    </div>
                </div>

                <!-- Live Student Score Logs -->
                <div class="space-y-3">
                    <div class="flex justify-between items-center">
                        <h3 class="font-semibold text-sm text-slate-700">🔴 Live บันทึกประวัติการเล่นสด</h3>
                        <span class="text-xs bg-emerald-50 text-emerald-600 px-2.5 py-1 rounded-full font-medium" id="total-logs-count">0 รายการ</span>
                    </div>
                    <div id="admin-scores-list" class="space-y-2 max-h-52 overflow-y-auto text-sm">
                        <!-- Injected by JS -->
                    </div>
                </div>
            </div>
        </div>

    </main>

    <!-- Footer -->
    <footer class="text-center py-4 text-xs text-slate-400">
        Math Adventure App • พัฒนาขึ้นเพื่อการเรียนการสอนคณิตศาสตร์ ป.5
    </footer>

    <!-- JavaScript Game & Admin Logic -->
    <script>
        let defaultQuestions = [
            { q: "ผลบวกของ 3/4 + 1/6 เท่ากับเท่าใด?", options: ["11/12", "4/10", "5/12", "1/2"], correct: 0 },
            { q: "25% ของเงิน 800 บาท คิดเป็นกี่บาท?", options: ["150 บาท", "200 บาท", "250 บาท", "300 บาท"], correct: 1 },
            { q: "ผลลบของ 7/8 - 2/5 เท่ากับเท่าใด?", options: ["5/3", "19/40", "9/40", "5/8"], correct: 1 },
            { q: "2เศษ2/4 + 2เศษ2/4 มีค่าเท่ากับข้อใด?", options: ["4", "4เศษ4/4", "5", "5เศษ1/2"], correct: 2 },
            { q: "ข้อใดคือความหมายของร้อยละ 15?", options: ["15 ส่วน 10", "15 ส่วน 100", "100 ส่วน 15", "15 ส่วน 1000"], correct: 1 }
        ];

        let questions = JSON.parse(localStorage.getItem('math_questions')) || defaultQuestions;
        let scoresHistory = JSON.parse(localStorage.getItem('math_scores')) || [];

        let currentQIndex = 0;
        let currentScore = 0;
        let playerName = "";

        // Tab Switching with Password Check (1111)
        function switchTab(tab) {
            const studentView = document.getElementById('view-student');
            const adminView = document.getElementById('view-admin');
            const btnStudent = document.getElementById('nav-student');
            const btnAdmin = document.getElementById('nav-admin');

            if (tab === 'admin') {
                let password = prompt("🔐 กรุณากรอกรหัสผ่านแอดมิน (1111):");
                if (password === null) return;
                if (password !== "1111") {
                    alert("❌ รหัสผ่านไม่ถูกต้อง!");
                    return;
                }
            }

            if (tab === 'student') {
                studentView.classList.remove('hidden');
                adminView.classList.add('hidden');
                btnStudent.className = "px-3 py-1.5 rounded-full text-sm font-medium bg-pink-500 text-white transition";
                btnAdmin.className = "px-3 py-1.5 rounded-full text-sm font-medium bg-gray-100 text-slate-600 hover:bg-gray-200 transition";
            } else {
                studentView.classList.add('hidden');
                adminView.classList.remove('hidden');
                btnAdmin.className = "px-3 py-1.5 rounded-full text-sm font-medium bg-purple-600 text-white transition";
                btnStudent.className = "px-3 py-1.5 rounded-full text-sm font-medium bg-gray-100 text-slate-600 hover:bg-gray-200 transition";
                renderAdminScores();
            }
        }

        // Game Flow
        function startGame() {
            const nameInput = document.getElementById('player-name').value.trim();
            if (!nameInput) {
                alert("กรุณากรอกชื่อเล่นก่อนเริ่มเล่นเกมครับ!");
                return;
            }
            playerName = nameInput;
            currentQIndex = 0;
            currentScore = 0;

            document.getElementById('card-start').classList.add('hidden');
            document.getElementById('card-quiz').classList.remove('hidden');
            loadQuestion();
        }

        function loadQuestion() {
            if (currentQIndex >= questions.length) {
                endGame();
                return;
            }

            const qData = questions[currentQIndex];
            document.getElementById('quiz-progress').innerText = `คำถามที่ ${currentQIndex + 1}/${questions.length}`;
            document.getElementById('quiz-score').innerText = currentScore;
            document.getElementById('quiz-question').innerText = qData.q;

            const optionsContainer = document.getElementById('quiz-options');
            optionsContainer.innerHTML = '';

            qData.options.forEach((opt, index) => {
                const btn = document.createElement('button');
                btn.className = "w-full p-3.5 rounded-2xl border border-slate-200 bg-white font-medium text-slate-700 hover:border-pink-400 hover:bg-pink-50/50 transition text-left flex items-center space-x-3";
                btn.innerHTML = `<span class="w-6 h-6 rounded-full bg-slate-100 text-slate-500 flex items-center justify-center text-xs font-bold">${index + 1}</span> <span>${opt}</span>`;
                btn.onclick = () => checkAnswer(index, qData.correct);
                optionsContainer.appendChild(btn);
            });
        }

        function checkAnswer(selected, correct) {
            if (selected === correct) {
                currentScore += 10;
                alert("🎉 ถูกต้องเก่งมาก!");
            } else {
                alert("❌ ยังไม่ถูกต้อง ลองใหม่ในข้อถัดไปนะ");
            }
            currentQIndex++;
            loadQuestion();
        }

        function endGame() {
            document.getElementById('card-quiz').classList.add('hidden');
            document.getElementById('card-result').classList.remove('hidden');
            document.getElementById('final-score').innerText = currentScore;
            document.getElementById('result-summary').innerText = `ยอดเยี่ยมมาก คุณ ${playerName} ทำคะแนนได้รวม`;

            // Save live log with timestamp
            const now = new Date();
            const timeString = now.toLocaleDateString('th-TH') + ' ' + now.toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' });
            
            scoresHistory.unshift({ name: playerName, score: currentScore, date: timeString });
            localStorage.setItem('math_scores', JSON.stringify(scoresHistory));
        }

        function resetGame() {
            document.getElementById('card-result').classList.add('hidden');
            document.getElementById('card-start').classList.remove('hidden');
            document.getElementById('player-name').value = '';
        }

        // Admin Actions
        function addQuestion() {
            const q = document.getElementById('admin-q').value.trim();
            const opt0 = document.getElementById('admin-opt0').value.trim();
            const opt1 = document.getElementById('admin-opt1').value.trim();
            const opt2 = document.getElementById('admin-opt2').value.trim();
            const opt3 = document.getElementById('admin-opt3').value.trim();
            const correct = parseInt(document.getElementById('admin-correct').value);

            if (!q || !opt0 || !opt1) {
                alert("กรุณากรอกโจทย์และอย่างน้อย 2 ตัวเลือกครับ");
                return;
            }

            questions.push({ q, options: [opt0, opt1, opt2, opt3].filter(Boolean), correct });
            localStorage.setItem('math_questions', JSON.stringify(questions));
            alert("✅ เพิ่มโจทย์ใหม่สำเร็จ!");
            
            document.getElementById('admin-q').value = '';
            document.getElementById('admin-opt0').value = '';
            document.getElementById('admin-opt1').value = '';
            document.getElementById('admin-opt2').value = '';
            document.getElementById('admin-opt3').value = '';
        }

        function renderAdminScores() {
            const list = document.getElementById('admin-scores-list');
            document.getElementById('total-logs-count').innerText = `${scoresHistory.length} รายการ`;
            
            if (scoresHistory.length === 0) {
                list.innerHTML = `<p class="text-slate-400 text-xs text-center py-4">ยังไม่มีประวัติการเล่นสด</p>`;
                return;
            }
            list.innerHTML = scoresHistory.map(s => `
                <div class="flex justify-between items-center bg-slate-50 p-3 rounded-xl border border-slate-100 shadow-sm">
                    <div class="flex items-center space-x-2">
                        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                        <span class="font-medium text-slate-700">👤 ${s.name}</span>
                    </div>
                    <div class="space-x-3 text-xs flex items-center">
                        <span class="text-pink-500 font-bold bg-pink-50 px-2.5 py-1 rounded-lg">${s.score} คะแนน</span>
                        <span class="text-slate-400">${s.date}</span>
                    </div>
                </div>
            `).join('');
        }

        function clearHistory() {
            if (confirm("คุณต้องการล้างประวัติการเล่นทั้งหมดใช่หรือไม่?")) {
                scoresHistory = [];
                localStorage.removeItem('math_scores');
                renderAdminScores();
            }
        }

        function exportData() {
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(scoresHistory));
            const downloadAnchor = document.createElement('a');
            downloadAnchor.setAttribute("href", dataStr);
            downloadAnchor.setAttribute("download", "math_live_scores_backup.json");
            document.body.appendChild(downloadAnchor);
            downloadAnchor.click();
            downloadAnchor.remove();
        }

        // Scratchpad Canvas Logic
        const canvas = document.getElementById('scratch-canvas');
        const ctx = canvas.getContext('2d');
        let painting = false;

        function startPosition(e) { painting = true; draw(e); }
        function endPosition() { painting = false; ctx.beginPath(); }
        function draw(e) {
            if (!painting) return;
            ctx.lineWidth = 3;
            ctx.lineCap = 'round';
            ctx.strokeStyle = '#7c3aed';

            const rect = canvas.getBoundingClientRect();
            const x = (e.clientX || e.touches[0].clientX) - rect.left;
            const y = (e.clientY || e.touches[0].clientY) - rect.top;

            ctx.lineTo(x, y);
            ctx.stroke();
            ctx.beginPath();
            ctx.moveTo(x, y);
        }

        function clearCanvas() { ctx.clearRect(0, 0, canvas.width, canvas.height); }

        function toggleScratchpad() {
            const pad = document.getElementById('scratchpad-container');
            pad.classList.toggle('hidden');
            canvas.width = canvas.offsetWidth;
            canvas.height = 192;
        }

        canvas.addEventListener('mousedown', startPosition);
        canvas.addEventListener('mouseup', endPosition);
        canvas.addEventListener('mousemove', draw);
        canvas.addEventListener('touchstart', startPosition);
        canvas.addEventListener('touchend', endPosition);
        canvas.addEventListener('touchmove', draw);
    </script>
</body>
</html>
